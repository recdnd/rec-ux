  "blocks": [
   [
    [
     110,
     "  function step(st, dt, mL, mR, bias, opt) {"
    ],
    [
     111,
     "    var o = opt || {};"
    ],
    [
     112,
     "    var inert = (o.inert == null ? 0.45 : o.inert);"
    ],
    [
     119,
     "    var zeta  = (o.zeta  == null ? 0.58 : o.zeta);"
    ],
    [
     120,
     "    var tot = mL + mR;"
    ],
    [
     121,
     "    var diff = reading(mL, mR, bias);"
    ],
    [
     122,
     "    var soft = Math.max(2, (tot * 0.10) + 2);"
    ],
    [
     139,
     "    var tgt = -GEO.MAXT * Math.tanh(diff / soft);",
     "左右の重さの差を、梁の傾きの目標にする。差が大きいほど傾き、上限で頭打ちになる。"
    ],
    [
     143,
     "    if (bias && bias.kind === 'stiction') {",
     "引っかかりのある秤では、差が小さいうちは梁が動かない。"
    ],
    [
     144,
     "      var band = (+bias.amt || 0) * GEO.MAXT * 2;"
    ],
    [
     145,
     "      if (Math.abs(tgt - st.th) < band) tgt = st.th;"
    ],
    [
     146,
     "    }"
    ],
    [
     161,
     "    st.t = (st.t || 0) + dt;"
    ],
    [
     162,
     "    tgt += 0.014 * (Math.sin(st.t * 1.6 + 0.7) * 0.65 + Math.sin(st.t * 3.7 + 2.1) * 0.35)",
     "二つの正弦でわずかに揺らす。乱数を使わないので、同じ局面は毎回同じ動きになる。"
    ],
    [
     163,
     "                 / (1 + tot / 200);"
    ],
    [
     165,
     "    var w0 = 7.4 / (1 + inert * Math.min(3.2, tot / 90));",
     "載っている量が多いほど、ゆっくり揺れる。"
    ],
    [
     166,
     "    st.thV += (-(w0 * w0) * (st.th - tgt) - 2 * zeta * w0 * st.thV) * dt;",
     "ばねと減衰の運動方程式。減衰は臨界より弱く、少し揺れてから止まる。"
    ],
    [
     167,
     "    st.th += st.thV * dt;"
    ],
    [
     168,
     "    if (st.th >  GEO.MAXT) { st.th =  GEO.MAXT; if (st.thV > 0) st.thV *= -0.18; }"
    ],
    [
     169,
     "    if (st.th < -GEO.MAXT) { st.th = -GEO.MAXT; if (st.thV < 0) st.thV *= -0.18; }"
    ],
    [
     171,
     "    for (var s = 0; s < 2; s++) {",
     "皿は梁から吊った振り子として、梁とは別に動く。"
    ],
    [
     172,
     "      var sgn = s === 0 ? -1 : 1;"
    ],
    [
     173,
     "      var ax = -sgn * GEO.ARM * st.thV;"
    ],
    [
     174,
     "      var wp = 5.6, zp = 0.45;"
    ],
    [
     175,
     "      st.phV[s] += (-(wp * wp) * st.ph[s] - 2 * zp * wp * st.phV[s] - ax * 0.055) * dt;"
    ],
    [
     176,
     "      st.ph[s] += st.phV[s] * dt;"
    ],
    [
     177,
     "      st.squash[s] *= Math.pow(0.0025, dt);"
    ],
    [
     178,
     "    }"
    ],
    [
     179,
     "    return st;"
    ],
    [
     180,
     "  }"
    ]
   ],
   [
    [
     202,
     "  function judge(st, myLeft) {"
    ],
    [
     205,
     "    var mine = (myLeft === false) ? st.th : -st.th;"
    ],
    [
     206,
     "    var low = mine > EPS;",
     "成立は、この瞬間に自分の皿が下がっているかだけで決める。"
    ],
    [
     207,
     "    return {"
    ],
    [
     208,
     "      ok: low,"
    ],
    [
     209,
     "      tilt: mine,"
    ],
    [
     212,
     "      say: low ? '成交.' : (mine < -EPS ? '他那邊還沉著.' : '還平著.')"
    ],
    [
     213,
     "    };"
    ]
   ]
  ]
 },
